{
  "_version": "1.84.0",
  "sap.app": {
    "id": "z00196ss26.vehicle.rental",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.23.0",
      "toolsId": "b30bd913-75f0-46b4-8bd1-b558c3190360"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/Z_00_196_SS26_VR_BINDING/?sap-client=300",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://car-rental"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.147.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "z00196ss26.vehicle.rental.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "useBatch": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "z00196ss26.vehicle.rental.view",
        "async": true,
        "viewPath": "z00196ss26.vehicle.rental.view"
      },
      "routes": [
        {
          "name": "Dashboard",
          "pattern": "",
          "target": ["TargetDashboard"]
        },
        {
          "name": "VehicleList",
          "pattern": "vehicles",
          "target": ["TargetVehicleList"]
        },
        {
          "name": "RentalList",
          "pattern": "rentals",
          "target": ["TargetRentalList"]
        }
      ],
      "targets": {
        "TargetDashboard": {
          "id": "Dashboard",
          "name": "Dashboard"
        },
        "TargetVehicleList": {
          "id": "VehicleList",
          "name": "VehicleList"
        },
        "TargetRentalList": {
          "id": "RentalList",
          "name": "RentalList"
        }
      }
    },
    "rootView": {
      "viewName": "z00196ss26.vehicle.rental.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
