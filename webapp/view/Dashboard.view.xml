<mvc:View
    controllerName="z00196ss26.vehicle.rental.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fCards="sap.f.cards"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Page id="dashboardPage" showHeader="false">
        <content>
            <Panel id="dashHeaderPanel" class="sapUiNoContentPadding">
                <Toolbar id="dashHeaderToolbar" class="dashboardHeader" height="4rem">
                    <core:Icon id="dashHeaderIcon" src="sap-icon://car-rental" size="1.75rem" class="sapUiSmallMarginBegin sapUiSmallMarginEnd" color="#0070f2"/>
                    <Title id="dashHeaderTitle" text="{i18n>appTitle}" level="H2"/>
                    <ToolbarSpacer id="dashHeaderSpacer"/>
                    <Button id="dashRefreshButton" icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefreshDashboard" type="Transparent"/>
                </Toolbar>
            </Panel>

            <VBox id="dashContentBox" class="sapUiResponsiveMargin">

                <!-- BANNER -->
                <Panel id="dashBannerPanel" class="dashboardBanner heroBanner sapUiSmallMarginBottom">
                    <HBox id="dashBannerRow" alignItems="Center" justifyContent="SpaceBetween" class="heroRow">
                        <VBox id="dashBannerTextBox" class="heroTextBox">
                            <Text id="dashBannerEyebrow" text="AI Insights" class="heroEyebrow"/>
                            <Title id="dashBannerTitle" text="Smarter Fleet Decisions" level="H3" class="heroTitle"/>
                            <Text id="dashBannerText" text="{i18n>heroDescription}" class="heroSub"/>
                            <HBox id="dashBannerCta" alignItems="Center" class="heroCtaRow">
                                <Button id="dashBannerAiButton" text="Ask AI" icon="sap-icon://discussion-2" type="Emphasized" press=".onOpenAiDialog"/>
                                <Text id="dashBannerHint" text="Try: Show available vehicles today" class="heroHint"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </Panel>

                <!-- KPI ROW -->
                <layout:Grid id="dashKpiGrid" defaultSpan="XL4 L4 M6 S12" class="sapUiSmallMarginBottom">

                    <f:Card id="dashKpiCardVehicles" width="100%">
                        <f:header>
                            <fCards:NumericHeader
                                id="dashKpiHeaderVehicles"
                                title="{i18n>totalVehicles}"
                                subtitle="{i18n>fleetOverview}"
                                number="{dashboard>/vehicleCount}"
                                scale="{i18n>vehicles}"
                                state="Good"/>
                        </f:header>
                        <f:content>
                            <HBox id="dashKpiVehiclesRow" justifyContent="SpaceAround" class="sapUiSmallMargin kpiFooterRow">
                                <VBox id="dashKpiAvailableBox" alignItems="Center" class="kpiFooterItem">
                                    <ObjectStatus id="dashKpiAvailableValue" text="{dashboard>/availableCount}" state="Success" inverted="true" class="kpiNumber kpiBadge"/>
                                    <Label id="dashKpiAvailableLabel" text="{i18n>filterAvailable}" class="kpiFooterLabel"/>
                                </VBox>
                                <VBox id="dashKpiRentedBox" alignItems="Center" class="kpiFooterItem">
                                    <ObjectStatus id="dashKpiRentedValue" text="{dashboard>/rentedCount}" state="Error" inverted="true" class="kpiNumber kpiBadge"/>
                                    <Label id="dashKpiRentedLabel" text="{i18n>filterRented}" class="kpiFooterLabel"/>
                                </VBox>
                            </HBox>
                        </f:content>
                    </f:Card>

                    <f:Card id="dashKpiCardRentals" width="100%">
                        <f:header>
                            <fCards:NumericHeader
                                id="dashKpiHeaderRentals"
                                title="{i18n>activeRentals}"
                                subtitle="{i18n>currentlyRented}"
                                number="{dashboard>/activeCount}"
                                scale="{i18n>active}"
                                state="Good"/>
                        </f:header>
                        <f:content>
                            <HBox id="dashKpiRentalsRow" justifyContent="SpaceAround" class="sapUiSmallMargin kpiFooterRow">
                                <VBox id="dashKpiOpenBox" alignItems="Center" class="kpiFooterItem">
                                    <ObjectStatus id="dashKpiOpenValue" text="{dashboard>/openCount}" state="Warning" inverted="true" class="kpiNumber kpiBadge"/>
                                    <Label id="dashKpiOpenLabel" text="{i18n>statusOpen}" class="kpiFooterLabel"/>
                                </VBox>
                                <VBox id="dashKpiClosedBox" alignItems="Center" class="kpiFooterItem">
                                    <ObjectStatus id="dashKpiClosedValue" text="{dashboard>/closedCount}" state="None" inverted="true" class="kpiNumber kpiBadge"/>
                                    <Label id="dashKpiClosedLabel" text="{i18n>statusClosed}" class="kpiFooterLabel"/>
                                </VBox>
                            </HBox>
                        </f:content>
                    </f:Card>

                    <f:Card id="dashKpiCardRevenue" width="100%">
                        <f:header>
                            <fCards:NumericHeader
                                id="dashKpiHeaderRevenue"
                                title="{i18n>revenue}"
                                subtitle="{i18n>totalBookingValue}"
                                number="{dashboard>/totalRevenue}"
                                scale="EUR"
                                state="Good"/>
                        </f:header>
                        <f:content>
                            <HBox id="dashKpiRevenueRow" justifyContent="SpaceAround" class="sapUiSmallMargin kpiFooterRow">
                                <VBox id="dashKpiTotalBookingsBox" alignItems="Center" class="kpiFooterItem">
                                    <ObjectStatus id="dashKpiTotalBookingsValue" text="{dashboard>/totalRentals}" state="Information" inverted="true" class="kpiNumber kpiBadge"/>
                                    <Label id="dashKpiTotalBookingsLabel" text="{i18n>totalBookings}" class="kpiFooterLabel"/>
                                </VBox>
                                <VBox id="dashKpiAvgRateBox" alignItems="Center" class="kpiFooterItem">
                                    <ObjectStatus id="dashKpiAvgRateValue" text="{dashboard>/avgRate}" state="Information" inverted="true" class="kpiNumber kpiBadge"/>
                                    <Label id="dashKpiAvgRateLabel" text="{i18n>avgDailyRate}" class="kpiFooterLabel"/>
                                </VBox>
                            </HBox>
                        </f:content>
                    </f:Card>

                </layout:Grid>

                <!-- ACTION CARDS -->
                <layout:Grid id="dashActionGrid" defaultSpan="XL6 L6 M6 S12">

                    <VBox id="dashVehiclesCard" class="actionCard">
                        <HBox id="dashVehiclesHeader" class="actionCardHeader" alignItems="Center">
                            <core:Icon id="dashVehiclesIcon" src="sap-icon://car-rental" size="1.25rem" class="sapUiSmallMarginEnd"/>
                            <Title id="dashVehiclesTitle" text="{i18n>manageVehicles}" level="H5"/>
                        </HBox>
                        <VBox id="dashVehiclesBody" class="actionCardBody">
                            <Text id="dashVehiclesDesc" text="{i18n>cardVehicleFleetDesc}" class="actionCardDesc"/>
                            <VBox id="dashVehiclesFooter" class="actionCardFooter">
                                <Link id="dashVehiclesLink" text="{i18n>viewAllVehicles}" press=".onNavToVehicles"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <VBox id="dashRentalsCard" class="actionCard">
                        <HBox id="dashRentalsHeader" class="actionCardHeader" alignItems="Center">
                            <core:Icon id="dashRentalsIcon" src="sap-icon://document-text" size="1.25rem" class="sapUiSmallMarginEnd"/>
                            <Title id="dashRentalsTitle" text="{i18n>manageRentals}" level="H5"/>
                        </HBox>
                        <VBox id="dashRentalsBody" class="actionCardBody">
                            <Text id="dashRentalsDesc" text="{i18n>cardRentalBookingsDesc}" class="actionCardDesc"/>
                            <VBox id="dashRentalsFooter" class="actionCardFooter">
                                <Link id="dashRentalsLink" text="{i18n>viewAllRentals}" press=".onNavToRentals"/>
                            </VBox>
                        </VBox>
                    </VBox>

                </layout:Grid>

            </VBox>
        </content>

        <dependents>
            <Dialog
                id="dashAiDialog"
                title="AI Assistant"
                contentWidth="640px"
                contentHeight="420px"
                stretch="{= ${device>/system/phone} }"
                class="heroAiDialog">
                <content>
                    <VBox id="dashAiDialogPanel" class="heroAiDialogPanel">
                        <VBox id="dashAiDialogMessages" class="heroAiMessages">
                            <HBox id="dashAiDialogBubbleUser" justifyContent="End" class="heroAiBubble heroAiBubbleUser">
                                <Text id="dashAiDialogTextUser" text="Any vehicles available today?" class="heroAiText"/>
                            </HBox>
                            <HBox id="dashAiDialogBubbleBot" class="heroAiBubble heroAiBubbleBot">
                                <Text id="dashAiDialogTextBot" text="8 vehicles are available. Want the lowest rate?" class="heroAiText"/>
                            </HBox>
                        </VBox>
                        <HBox id="dashAiDialogInput" alignItems="Center" class="heroAiInput">
                            <Input
                                id="dashAiDialogInputField"
                                placeholder="Ask about vehicles, rentals, revenue..."
                                submit=".onAiSend"
                                class="heroAiInputField"/>
                            <Button
                                id="dashAiDialogSendButton"
                                icon="sap-icon://paper-plane"
                                type="Emphasized"
                                press=".onAiSend"
                                class="heroAiSendButton"/>
                        </HBox>
                    </VBox>
                </content>
                <endButton>
                    <Button id="dashAiDialogClose" text="Close" press=".onCloseAiDialog"/>
                </endButton>
            </Dialog>
        </dependents>
    </Page>
</mvc:View>
