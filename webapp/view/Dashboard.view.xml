<mvc:View
    controllerName="z00196ss26.vehicle.rental.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Page id="dashboardPage" showHeader="false">
        <content>

            <!-- ═══ PAGE HEADER ═══ -->
            <Panel id="dashHeaderPanel" class="sapUiNoContentPadding">
                <Toolbar id="dashHeaderToolbar" class="dashboardHeader" height="4rem">
                    <core:Icon id="dashHeaderIcon" src="sap-icon://car-rental" size="1.75rem" class="sapUiSmallMarginBegin sapUiSmallMarginEnd" color="#0070f2"/>
                    <Title id="dashHeaderTitle" text="{i18n>appTitle}" level="H2"/>
                    <ToolbarSpacer id="dashHeaderSpacer"/>
                    <Button id="dashRefreshButton" icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefreshDashboard" type="Transparent"/>
                </Toolbar>
            </Panel>

            <VBox id="dashContentBox" class="sapUiResponsiveMargin">

                <!-- ═══ HERO: AI ASSISTANT ═══ -->
                <VBox id="dashHeroPanel" class="dashHero sapUiSmallMarginBottom" alignItems="Center">
                    <Text id="dashHeroEyebrow" text="Fleet AI" class="dashHeroEyebrow"/>
                    <Title id="dashHeroTitle" text="{i18n>heroAiTitle}" level="H1" class="dashHeroTitle"/>
                    <Text id="dashHeroSub" text="{i18n>heroAiSub}" class="dashHeroSub"/>
                    <SearchField
                        id="dashHeroInput"
                        placeholder="{i18n>heroAiHint}"
                        search=".onHeroAiSend"
                        showSearchButton="true"
                        class="dashHeroSearchField"/>
                </VBox>

                <!-- ═══ KPI CARDS ═══ -->
                <layout:Grid id="dashKpiGrid" defaultSpan="XL4 L4 M6 S12" class="sapUiSmallMarginBottom">

                    <!-- Fleet -->
                    <VBox id="dashKpiVehicles" class="kpiCard kpiCardBlue">
                        <HBox id="dashKpiVehiclesTop" justifyContent="SpaceBetween" alignItems="Center" class="kpiCardTopRow">
                            <VBox id="dashKpiVehiclesLabelBox">
                                <Text id="dashKpiVehiclesTitle" text="{i18n>totalVehicles}" class="kpiCardLabel"/>
                                <Text id="dashKpiVehiclesSub" text="{i18n>fleetOverview}" class="kpiCardSub"/>
                            </VBox>
                            <HBox id="dashKpiVehiclesIconBox" class="kpiIconBox kpiIconBoxBlue" alignItems="Center" justifyContent="Center">
                                <core:Icon id="dashKpiVehiclesIcon" src="sap-icon://car-rental" size="1.35rem"/>
                            </HBox>
                        </HBox>
                        <Text id="dashKpiVehiclesNumber" text="{dashboard>/vehicleCount}" class="kpiCardNumber"/>
                        <HBox id="dashKpiVehiclesMetrics" class="kpiCardMetrics">
                            <VBox id="dashKpiAvailBox" class="kpiMetricItem" alignItems="Center">
                                <ObjectStatus id="dashKpiAvailBadge" text="{dashboard>/availableCount}" state="Success" inverted="true" class="kpiBadge"/>
                                <Text id="dashKpiAvailLbl" text="{i18n>filterAvailable}" class="kpiMetricLabel"/>
                            </VBox>
                            <VBox id="dashKpiRentedBox" class="kpiMetricItem" alignItems="Center">
                                <ObjectStatus id="dashKpiRentedBadge" text="{dashboard>/rentedCount}" state="Error" inverted="true" class="kpiBadge"/>
                                <Text id="dashKpiRentedLbl" text="{i18n>filterRented}" class="kpiMetricLabel"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Rentals -->
                    <VBox id="dashKpiRentals" class="kpiCard kpiCardGreen">
                        <HBox id="dashKpiRentalsTop" justifyContent="SpaceBetween" alignItems="Center" class="kpiCardTopRow">
                            <VBox id="dashKpiRentalsLabelBox">
                                <Text id="dashKpiRentalsTitle" text="{i18n>activeRentals}" class="kpiCardLabel"/>
                                <Text id="dashKpiRentalsSub" text="{i18n>currentlyRented}" class="kpiCardSub"/>
                            </VBox>
                            <HBox id="dashKpiRentalsIconBox" class="kpiIconBox kpiIconBoxGreen" alignItems="Center" justifyContent="Center">
                                <core:Icon id="dashKpiRentalsIcon" src="sap-icon://document-text" size="1.35rem"/>
                            </HBox>
                        </HBox>
                        <Text id="dashKpiRentalsNumber" text="{dashboard>/activeCount}" class="kpiCardNumber"/>
                        <HBox id="dashKpiRentalsMetrics" class="kpiCardMetrics">
                            <VBox id="dashKpiOpenBox" class="kpiMetricItem" alignItems="Center">
                                <ObjectStatus id="dashKpiOpenBadge" text="{dashboard>/openCount}" state="Warning" inverted="true" class="kpiBadge"/>
                                <Text id="dashKpiOpenLbl" text="{i18n>statusOpen}" class="kpiMetricLabel"/>
                            </VBox>
                            <VBox id="dashKpiClosedBox" class="kpiMetricItem" alignItems="Center">
                                <ObjectStatus id="dashKpiClosedBadge" text="{dashboard>/closedCount}" state="None" inverted="true" class="kpiBadge"/>
                                <Text id="dashKpiClosedLbl" text="{i18n>statusClosed}" class="kpiMetricLabel"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Revenue -->
                    <VBox id="dashKpiRevenue" class="kpiCard kpiCardOrange">
                        <HBox id="dashKpiRevenueTop" justifyContent="SpaceBetween" alignItems="Center" class="kpiCardTopRow">
                            <VBox id="dashKpiRevenueLabelBox">
                                <Text id="dashKpiRevenueTitle" text="{i18n>revenue}" class="kpiCardLabel"/>
                                <Text id="dashKpiRevenueSub" text="{i18n>totalBookingValue}" class="kpiCardSub"/>
                            </VBox>
                            <HBox id="dashKpiRevenueIconBox" class="kpiIconBox kpiIconBoxOrange" alignItems="Center" justifyContent="Center">
                                <core:Icon id="dashKpiRevenueIcon" src="sap-icon://money-bills" size="1.35rem"/>
                            </HBox>
                        </HBox>
                        <HBox id="dashKpiRevenueNumRow" alignItems="Baseline">
                            <Text id="dashKpiRevenueNumber" text="{dashboard>/totalRevenue}" class="kpiCardNumber kpiCardNumberMd"/>
                            <Text id="dashKpiRevenueCurrency" text=" EUR" class="kpiCardCurrency"/>
                        </HBox>
                        <HBox id="dashKpiRevenueMetrics" class="kpiCardMetrics">
                            <VBox id="dashKpiBkgBox" class="kpiMetricItem" alignItems="Center">
                                <ObjectStatus id="dashKpiBkgBadge" text="{dashboard>/totalRentals}" state="Information" inverted="true" class="kpiBadge"/>
                                <Text id="dashKpiBkgLbl" text="{i18n>totalBookings}" class="kpiMetricLabel"/>
                            </VBox>
                            <VBox id="dashKpiAvgBox" class="kpiMetricItem" alignItems="Center">
                                <ObjectStatus id="dashKpiAvgBadge" text="{dashboard>/avgRate}" state="Information" inverted="true" class="kpiBadge"/>
                                <Text id="dashKpiAvgLbl" text="{i18n>avgDailyRate}" class="kpiMetricLabel"/>
                            </VBox>
                        </HBox>
                    </VBox>

                </layout:Grid>

                <!-- ═══ NAV CARDS ═══ -->
                <layout:Grid id="dashNavGrid" defaultSpan="XL6 L6 M6 S12">

                    <VBox id="dashNavVehicles" class="navCard">
                        <HBox id="dashNavVehiclesTop" justifyContent="SpaceBetween" alignItems="Start" class="navCardTop">
                            <HBox id="dashNavVehiclesIconWrap" class="navCardIconBox navCardIconBlue" alignItems="Center" justifyContent="Center">
                                <core:Icon id="dashNavVehiclesIcon" src="sap-icon://car-rental" size="1.5rem"/>
                            </HBox>
                            <Text id="dashNavVehiclesCount" text="{dashboard>/vehicleCount}" class="navCardBadge"/>
                        </HBox>
                        <Title id="dashNavVehiclesTitle" text="{i18n>manageVehicles}" level="H4" class="navCardTitle"/>
                        <Text id="dashNavVehiclesDesc" text="{i18n>cardVehicleFleetDesc}" class="navCardDesc"/>
                        <HBox id="dashNavVehiclesFooter" class="navCardFooter" alignItems="Center">
                            <Link id="dashNavVehiclesLink" text="{i18n>viewAllVehicles}" press=".onNavToVehicles" class="navCardLink"/>
                            <core:Icon id="dashNavVehiclesArrow" src="sap-icon://slim-arrow-right" size="0.8rem" class="navCardArrow"/>
                        </HBox>
                    </VBox>

                    <VBox id="dashNavRentals" class="navCard">
                        <HBox id="dashNavRentalsTop" justifyContent="SpaceBetween" alignItems="Start" class="navCardTop">
                            <HBox id="dashNavRentalsIconWrap" class="navCardIconBox navCardIconGreen" alignItems="Center" justifyContent="Center">
                                <core:Icon id="dashNavRentalsIcon" src="sap-icon://document-text" size="1.5rem"/>
                            </HBox>
                            <Text id="dashNavRentalsCount" text="{dashboard>/totalRentals}" class="navCardBadge"/>
                        </HBox>
                        <Title id="dashNavRentalsTitle" text="{i18n>manageRentals}" level="H4" class="navCardTitle"/>
                        <Text id="dashNavRentalsDesc" text="{i18n>cardRentalBookingsDesc}" class="navCardDesc"/>
                        <HBox id="dashNavRentalsFooter" class="navCardFooter" alignItems="Center">
                            <Link id="dashNavRentalsLink" text="{i18n>viewAllRentals}" press=".onNavToRentals" class="navCardLink"/>
                            <core:Icon id="dashNavRentalsArrow" src="sap-icon://slim-arrow-right" size="0.8rem" class="navCardArrow"/>
                        </HBox>
                    </VBox>

                </layout:Grid>

            </VBox>
        </content>

        <dependents>
            <Dialog
                id="dashAiDialog"
                title="Fleet AI"
                contentWidth="560px"
                stretch="{= ${device>/system/phone} }"
                class="aiDialog">
                <content>
                    <List
                        id="dashAiChatList"
                        showSeparators="None"
                        class="aiChatList">
                        <FeedListItem
                            id="dashAiInitMsgUser"
                            sender="You"
                            text="Any vehicles available today?"
                            showIcon="false"
                            senderActive="false"/>
                        <FeedListItem
                            id="dashAiInitMsgBot"
                            sender="Fleet AI"
                            icon="sap-icon://discussion-2"
                            text="8 vehicles are available. Want the lowest rate?"
                            senderActive="false"/>
                    </List>
                    <FeedInput
                        id="dashAiFeedInput"
                        placeholder="Ask about vehicles, rentals, revenue..."
                        post=".onAiPost"
                        showIcon="false"
                        class="aiChatFeedInput"/>
                </content>
                <endButton>
                    <Button id="dashAiDialogClose" text="Close" press=".onCloseAiDialog"/>
                </endButton>
            </Dialog>
        </dependents>
    </Page>
</mvc:View>
