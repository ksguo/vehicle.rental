<mvc:View
    controllerName="z00196ss26.vehicle.rental.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="page" title="{i18n>appTitle}" class="sapUiContentPadding">
        <content>
            <IconTabBar id="iconTabBar" expandable="false" stretchContentHeight="true">
                <items>

                    <!-- ============ VEHICLE TAB ============ -->
                    <IconTabFilter
                        text="{i18n>vehicleTab}"
                        icon="sap-icon://car-rental"
                        key="vehicles">
                        <content>
                            <VBox>
                                <Toolbar class="sapUiSmallMarginBottom">
                                    <Label text="{i18n>showLabel}" class="sapUiSmallMarginEnd"/>
                                    <SegmentedButton id="vehicleFilter" selectionChange=".onVehicleFilterChange">
                                        <items>
                                            <SegmentedButtonItem key="ALL"   text="{i18n>filterAll}"/>
                                            <SegmentedButtonItem key="true"  text="{i18n>filterAvailable}"/>
                                            <SegmentedButtonItem key="false" text="{i18n>filterRented}"/>
                                        </items>
                                    </SegmentedButton>
                                    <ToolbarSpacer/>
                                    <Text id="vehicleCount"/>
                                </Toolbar>

                                <Table
                                    id="vehicleTable"
                                    items="{/Vehicle}"
                                    growing="true"
                                    growingThreshold="20"
                                    noDataText="{i18n>noVehicles}"
                                    updateFinished=".onVehicleTableUpdate">
                                    <headerToolbar>
                                        <Toolbar>
                                            <Title text="{i18n>vehicleList}" level="H3"/>
                                            <ToolbarSpacer/>
                                            <Button text="{i18n>addVehicle}" icon="sap-icon://add" press=".onAddVehicle" type="Emphasized"/>
                                        </Toolbar>
                                    </headerToolbar>
                                    <columns>
                                        <Column width="6rem"><Text text="{i18n>vehicleId}"/></Column>
                                        <Column><Text text="{i18n>brand}"/></Column>
                                        <Column><Text text="{i18n>model}"/></Column>
                                        <Column><Text text="{i18n>category}"/></Column>
                                        <Column><Text text="{i18n>fuelType}"/></Column>
                                        <Column><Text text="{i18n>transmission}"/></Column>
                                        <Column hAlign="Right"><Text text="{i18n>dailyRate}"/></Column>
                                        <Column hAlign="Right"><Text text="{i18n>mileage}"/></Column>
                                        <Column><Text text="{i18n>availability}"/></Column>
                                        <Column width="7rem"><Text text="{i18n>actions}"/></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem vAlign="Middle">
                                            <cells>
                                                <Text text="{VehicleId}"/>
                                                <Text text="{Brand}"/>
                                                <Text text="{Model}"/>
                                                <Text text="{Category}"/>
                                                <Text text="{FuelType}"/>
                                                <Text text="{Transmission}"/>
                                                <ObjectNumber number="{DailyRate}" unit="{CurrencyCode}"/>
                                                <Text text="{Mileage}"/>
                                                <ObjectStatus
                                                    text="{= ${Availability} ? 'Available' : 'Rented'}"
                                                    state="{= ${Availability} ? 'Success' : 'Error'}"
                                                    icon="{= ${Availability} ? 'sap-icon://accept' : 'sap-icon://decline'}"/>
                                                <HBox>
                                                    <Button icon="sap-icon://edit"   tooltip="{i18n>edit}"   press=".onEditVehicle"   type="Transparent"/>
                                                    <Button icon="sap-icon://delete" tooltip="{i18n>delete}" press=".onDeleteVehicle" type="Transparent"/>
                                                </HBox>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </content>
                    </IconTabFilter>

                    <!-- ============ RENTAL TAB ============ -->
                    <IconTabFilter
                        text="{i18n>rentalTab}"
                        icon="sap-icon://document-text"
                        key="rentals">
                        <content>
                            <Table
                                id="rentalTable"
                                items="{/Rental}"
                                growing="true"
                                growingThreshold="20"
                                noDataText="{i18n>noRentals}">
                                <headerToolbar>
                                    <Toolbar>
                                        <Title text="{i18n>rentalList}" level="H3"/>
                                        <ToolbarSpacer/>
                                        <Button text="{i18n>addRental}" icon="sap-icon://add" press=".onAddRental" type="Emphasized"/>
                                    </Toolbar>
                                </headerToolbar>
                                <columns>
                                    <Column width="6rem"><Text text="{i18n>rentalId}"/></Column>
                                    <Column width="6rem"><Text text="{i18n>vehicleId}"/></Column>
                                    <Column><Text text="{i18n>customerName}"/></Column>
                                    <Column><Text text="{i18n>pickupDate}"/></Column>
                                    <Column><Text text="{i18n>returnDate}"/></Column>
                                    <Column hAlign="Right"><Text text="{i18n>durationDays}"/></Column>
                                    <Column hAlign="Right"><Text text="{i18n>totalPrice}"/></Column>
                                    <Column><Text text="{i18n>status}"/></Column>
                                    <Column><Text text="{i18n>specialRequests}"/></Column>
                                    <Column width="10rem"><Text text="{i18n>actions}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem vAlign="Middle">
                                        <cells>
                                            <Text text="{RentalId}"/>
                                            <Text text="{VehicleId}"/>
                                            <Text text="{CustomerName}"/>
                                            <Text text="{PickupDate}"/>
                                            <Text text="{ReturnDate}"/>
                                            <ObjectNumber number="{DurationDays}"/>
                                            <ObjectNumber number="{TotalPrice}" unit="{CurrencyCode}"/>
                                            <ObjectStatus
                                                text="{Status}"
                                                state="{= ${Status} === 'ACTIVE' ? 'Success' : (${Status} === 'CLOSED' ? 'None' : 'Warning')}"/>
                                            <Text text="{SpecialRequests}"/>
                                            <HBox>
                                                <Button icon="sap-icon://edit"    tooltip="{i18n>edit}"           press=".onEditRental"    type="Transparent" visible="{= ${Status} !== 'CLOSED'}"/>
                                                <Button icon="sap-icon://delete"  tooltip="{i18n>delete}"         press=".onDeleteRental"  type="Transparent"/>
                                                <Button icon="sap-icon://accept"  tooltip="{i18n>confirmRental}"  press=".onConfirmRental" type="Transparent" visible="{= ${Status} === 'OPEN'}"/>
                                                <Button icon="sap-icon://process" tooltip="{i18n>closeRental}"    press=".onCloseRental"   type="Transparent" visible="{= ${Status} === 'ACTIVE'}"/>
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </content>
                    </IconTabFilter>

                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
