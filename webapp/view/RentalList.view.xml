<mvc:View
    controllerName="z00196ss26.vehicle.rental2.controller.RentalList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="rentalListPage"
          title="{i18n>manageRentals}"
          showNavButton="true"
          navButtonPress=".onNavBack">

        <content>
            <IconTabBar id="rentalIconTabBar"
                        select=".onFilterRental"
                        selectedKey="ALL"
                        class="sapUiNoContentPadding"
                        stretchContentHeight="false"
                        applyContentPadding="false">
                <items>
                    <IconTabFilter id="rentalTabAll"    key="ALL"    text="{i18n>filterAll}"    count="{rentalView>/allCount}"    showAll="true"/>
                    <IconTabSeparator id="rentalTabSep"/>
                    <IconTabFilter id="rentalTabOpen"   key="OPEN"   text="{i18n>statusOpen}"   count="{rentalView>/openCount}"   iconColor="Critical" icon="sap-icon://pending"/>
                    <IconTabFilter id="rentalTabActive" key="ACTIVE" text="{i18n>statusActive}" count="{rentalView>/activeCount}" iconColor="Positive" icon="sap-icon://accept"/>
                    <IconTabFilter id="rentalTabClosed" key="CLOSED" text="{i18n>statusClosed}" count="{rentalView>/closedCount}" iconColor="Neutral"  icon="sap-icon://complete"/>
                </items>
                <content>
                    <Table
                        id="rentalTable"
                        items="{/Rental}"
                        growing="true"
                        growingThreshold="20"
                        alternateRowColors="true"
                        sticky="ColumnHeaders,HeaderToolbar"
                        noDataText="{i18n>noRentals}"
                        updateFinished=".onTableUpdate">
                        <headerToolbar>
                            <OverflowToolbar id="rentalTableToolbar">
                                <SearchField id="rentalSearch"
                                    placeholder="{i18n>searchRentals}"
                                    liveChange=".onSearchRental"
                                    width="280px"/>
                                <ToolbarSpacer id="rentalToolbarSpacer"/>
                                <Button id="rentalAddButton" text="{i18n>addRental}" icon="sap-icon://add" press=".onAddRental" type="Emphasized"/>
                                <Button id="rentalRefreshButton" icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh" type="Transparent"/>
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column id="rentalColBooking" width="9rem">
                                <Text id="rentalColBookingText" text="{i18n>rentalId}"/>
                            </Column>
                            <Column id="rentalColCustomer">
                                <Text id="rentalColCustomerText" text="{i18n>customerName}"/>
                            </Column>
                            <Column id="rentalColPeriod" width="16rem">
                                <Text id="rentalColPeriodText" text="{i18n>period}"/>
                            </Column>
                            <Column id="rentalColAmount" width="9rem" hAlign="Right">
                                <Text id="rentalColAmountText" text="{i18n>totalPrice}"/>
                            </Column>
                            <Column id="rentalColStatus" width="9rem" hAlign="Center">
                                <Text id="rentalColStatusText" text="{i18n>status}"/>
                            </Column>
                            <Column id="rentalColActions" width="11rem" hAlign="Center">
                                <Text id="rentalColActionsText" text="{i18n>actions}"/>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem id="rentalListItem" vAlign="Middle">
                                <cells>

                                    <!-- Rental ID + Vehicle ID -->
                                    <VBox id="rentalCellBookingBox">
                                        <ObjectIdentifier id="rentalCellRentalId" title="{RentalId}"/>
                                        <Text id="rentalCellVehicleId" text="{VehicleId}" class="listSubText"/>
                                    </VBox>

                                    <!-- Customer + Special Requests -->
                                    <VBox id="rentalCellCustomerBox">
                                        <Text id="rentalCellCustomerName" text="{CustomerName}" class="customerNameText"/>
                                        <Text id="rentalCellRequests" text="{SpecialRequests}" class="listSubText" maxLines="1" wrapping="false"/>
                                    </VBox>

                                    <!-- Pickup → Return + Duration -->
                                    <VBox id="rentalCellPeriodBox">
                                        <HBox id="rentalCellDateRow" alignItems="Center">
                                            <Text id="rentalCellPickupDate"
                                                text="{path: 'PickupDate', formatter: '.formatter.formatDate'}"
                                                class="dateText"/>
                                            <core:Icon id="rentalCellDateArrow"
                                                src="sap-icon://navigation-right-arrow"
                                                size="0.65rem"
                                                class="dateArrowIcon"/>
                                            <Text id="rentalCellReturnDate"
                                                text="{path: 'ReturnDate', formatter: '.formatter.formatDate'}"
                                                class="dateText"/>
                                        </HBox>
                                        <Text id="rentalCellDuration"
                                            text="{= ${DurationDays} + ' days'}"
                                            class="listSubText"/>
                                    </VBox>

                                    <!-- Total Price -->
                                    <ObjectNumber id="rentalCellTotalPrice"
                                        number="{TotalPrice}"
                                        unit="{CurrencyCode}"
                                        emphasized="true"/>

                                    <!-- Status -->
                                    <ObjectStatus id="rentalCellStatus"
                                        text="{path: 'Status', formatter: '.formatter.rentalStatusText'}"
                                        state="{path: 'Status', formatter: '.formatter.rentalStatusState'}"
                                        icon="{path: 'Status', formatter: '.formatter.rentalStatusIcon'}"
                                        inverted="true"/>

                                    <!-- Actions -->
                                    <HBox id="rentalCellActions" justifyContent="Center" alignItems="Center">
                                        <Button id="rentalConfirmButton"
                                            icon="sap-icon://accept"
                                            tooltip="{i18n>confirmRental}"
                                            press=".onConfirmRental"
                                            type="Accept"
                                            visible="{= ${Status} === 'OPEN'}"/>
                                        <Button id="rentalCloseButton"
                                            icon="sap-icon://process"
                                            tooltip="{i18n>closeRental}"
                                            press=".onCloseRental"
                                            type="Transparent"
                                            visible="{= ${Status} === 'ACTIVE'}"/>
                                        <Button id="rentalEditButton"
                                            icon="sap-icon://edit"
                                            tooltip="{i18n>edit}"
                                            press=".onEditRental"
                                            type="Transparent"
                                            visible="{= ${Status} !== 'CLOSED'}"/>
                                        <Button id="rentalDeleteButton"
                                            icon="sap-icon://delete"
                                            tooltip="{i18n>delete}"
                                            press=".onDeleteRental"
                                            type="Transparent"/>
                                    </HBox>

                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
