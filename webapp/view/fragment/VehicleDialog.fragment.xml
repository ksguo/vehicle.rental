<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog id="vehicleDialog" title="{dialog>/title}" contentWidth="480px" draggable="true" resizable="true">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                columnsXL="1" columnsL="1" columnsM="1"
                class="sapUiSmallMargin">
                <f:content>
                    <Label text="{i18n>vehicleId}" required="true"/>
                    <Input value="{dialog>/VehicleId}" enabled="{dialog>/isNew}" maxLength="8" placeholder="e.g. 00000001"/>

                    <Label text="{i18n>brand}" required="true"/>
                    <Input value="{dialog>/Brand}" maxLength="30"/>

                    <Label text="{i18n>model}" required="true"/>
                    <Input value="{dialog>/Model}" maxLength="30"/>

                    <Label text="{i18n>category}" required="true"/>
                    <Select selectedKey="{dialog>/Category}">
                        <items>
                            <core:Item text="Economy" key="ECONOMY"/>
                            <core:Item text="Compact" key="COMPACT"/>
                            <core:Item text="SUV"     key="SUV"/>
                            <core:Item text="Luxury"  key="LUXURY"/>
                            <core:Item text="Van"     key="VAN"/>
                        </items>
                    </Select>

                    <Label text="{i18n>fuelType}"/>
                    <Select selectedKey="{dialog>/FuelType}">
                        <items>
                            <core:Item text="Petrol"   key="PETROL"/>
                            <core:Item text="Diesel"   key="DIESEL"/>
                            <core:Item text="Electric" key="ELECTRIC"/>
                            <core:Item text="Hybrid"   key="HYBRID"/>
                        </items>
                    </Select>

                    <Label text="{i18n>transmission}"/>
                    <Select selectedKey="{dialog>/Transmission}">
                        <items>
                            <core:Item text="Manual"    key="MANUAL"/>
                            <core:Item text="Automatic" key="AUTOMATIC"/>
                        </items>
                    </Select>

                    <Label text="{i18n>dailyRate}"/>
                    <Input value="{dialog>/DailyRate}" type="Number"/>

                    <Label text="{i18n>currency}"/>
                    <Input value="{dialog>/CurrencyCode}" maxLength="3" placeholder="EUR"/>

                    <Label text="{i18n>mileage}"/>
                    <Input value="{dialog>/Mileage}" type="Number"/>

                    <Label text="{i18n>availability}"/>
                    <CheckBox selected="{dialog>/Availability}"/>
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="{i18n>save}" press=".onSaveVehicle" type="Emphasized"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onCancelDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
