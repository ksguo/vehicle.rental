<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog id="vehicleDialog" title="{dialog>/title}" contentWidth="480px" draggable="true" resizable="true">
        <content>
            <f:SimpleForm id="vehicleDialogForm" editable="true" layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                columnsXL="1" columnsL="1" columnsM="1"
                class="sapUiSmallMargin">
                <f:content>
                    <Label id="vehicleDialogLabelVehicleId" text="{i18n>vehicleId}" required="true"/>
                    <Input id="vehicleDialogInputVehicleId" value="{dialog>/VehicleId}" enabled="{dialog>/isNew}" maxLength="8" placeholder="e.g. 00000001"/>

                    <Label id="vehicleDialogLabelBrand" text="{i18n>brand}" required="true"/>
                    <Input id="vehicleDialogInputBrand" value="{dialog>/Brand}" maxLength="30"/>

                    <Label id="vehicleDialogLabelModel" text="{i18n>model}" required="true"/>
                    <Input id="vehicleDialogInputModel" value="{dialog>/Model}" maxLength="30"/>

                    <Label id="vehicleDialogLabelCategory" text="{i18n>category}" required="true"/>
                    <Select id="vehicleDialogCategorySelect" selectedKey="{dialog>/Category}">
                        <items>
                            <core:Item id="vehicleDialogCategoryEconomy" text="Economy" key="ECONOMY"/>
                            <core:Item id="vehicleDialogCategoryCompact" text="Compact" key="COMPACT"/>
                            <core:Item id="vehicleDialogCategorySuv" text="SUV"     key="SUV"/>
                            <core:Item id="vehicleDialogCategoryLuxury" text="Luxury"  key="LUXURY"/>
                            <core:Item id="vehicleDialogCategoryVan" text="Van"     key="VAN"/>
                        </items>
                    </Select>

                    <Label id="vehicleDialogLabelFuelType" text="{i18n>fuelType}"/>
                    <Select id="vehicleDialogFuelTypeSelect" selectedKey="{dialog>/FuelType}">
                        <items>
                            <core:Item id="vehicleDialogFuelPetrol" text="Petrol"   key="PETROL"/>
                            <core:Item id="vehicleDialogFuelDiesel" text="Diesel"   key="DIESEL"/>
                            <core:Item id="vehicleDialogFuelElectric" text="Electric" key="ELECTRIC"/>
                            <core:Item id="vehicleDialogFuelHybrid" text="Hybrid"   key="HYBRID"/>
                        </items>
                    </Select>

                    <Label id="vehicleDialogLabelTransmission" text="{i18n>transmission}"/>
                    <Select id="vehicleDialogTransmissionSelect" selectedKey="{dialog>/Transmission}">
                        <items>
                            <core:Item id="vehicleDialogTransmissionManual" text="Manual"    key="MANUAL"/>
                            <core:Item id="vehicleDialogTransmissionAuto" text="Automatic" key="AUTOMATIC"/>
                        </items>
                    </Select>

                    <Label id="vehicleDialogLabelDailyRate" text="{i18n>dailyRate}"/>
                    <Input id="vehicleDialogInputDailyRate" value="{dialog>/DailyRate}" type="Number"/>

                    <Label id="vehicleDialogLabelCurrency" text="{i18n>currency}"/>
                    <Input id="vehicleDialogInputCurrency" value="{dialog>/CurrencyCode}" maxLength="3" placeholder="EUR"/>

                    <Label id="vehicleDialogLabelMileage" text="{i18n>mileage}"/>
                    <Input id="vehicleDialogInputMileage" value="{dialog>/Mileage}" type="Number"/>

                    <Label id="vehicleDialogLabelAvailability" text="{i18n>availability}"/>
                    <CheckBox id="vehicleDialogAvailabilityCheck" selected="{dialog>/Availability}"/>
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button id="vehicleDialogSaveButton" text="{i18n>save}" press=".onSaveVehicle" type="Emphasized"/>
        </beginButton>
        <endButton>
            <Button id="vehicleDialogCancelButton" text="{i18n>cancel}" press=".onCancelDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
