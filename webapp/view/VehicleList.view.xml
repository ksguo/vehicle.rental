<mvc:View
    controllerName="z00196ss26.vehicle.rental.controller.VehicleList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="vehicleListPage"
          title="{i18n>manageVehicles}"
          showNavButton="true"
          navButtonPress=".onNavBack">

        <content>
            <IconTabBar id="vehicleIconTabBar"
                        select=".onFilterVehicle"
                        selectedKey="ALL"
                        class="sapUiNoContentPadding"
                        stretchContentHeight="false"
                        applyContentPadding="false">
                <items>
                    <IconTabFilter id="vehicleTabAll" key="ALL"   text="{i18n>filterAll}"       count="{vehicleView>/allCount}"       showAll="true"/>
                    <IconTabSeparator id="vehicleTabSep"/>
                    <IconTabFilter id="vehicleTabAvailable" key="true"  text="{i18n>filterAvailable}" count="{vehicleView>/availableCount}" iconColor="Positive" icon="sap-icon://accept"/>
                    <IconTabFilter id="vehicleTabRented" key="false" text="{i18n>filterRented}"    count="{vehicleView>/rentedCount}"    iconColor="Negative" icon="sap-icon://decline"/>
                </items>
                <content>
                    <Table
                        id="vehicleTable"
                        items="{/Vehicle}"
                        growing="true"
                        growingThreshold="20"
                        alternateRowColors="true"
                        sticky="ColumnHeaders,HeaderToolbar"
                        noDataText="{i18n>noVehicles}"
                        updateFinished=".onTableUpdate">
                        <headerToolbar>
                            <OverflowToolbar id="vehicleTableToolbar">
                                <SearchField id="vehicleSearch"
                                    placeholder="{i18n>searchVehicles}"
                                    liveChange=".onSearchVehicle"
                                    width="300px"/>
                                <ToolbarSpacer id="vehicleToolbarSpacer"/>
                                <Button id="vehicleAddButton" text="{i18n>addVehicle}" icon="sap-icon://add" press=".onAddVehicle" type="Emphasized"/>
                                <Button id="vehicleRefreshButton" icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh" type="Transparent"/>
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column id="vehicleColVehicleId" width="6rem"><Text id="vehicleColVehicleIdText" text="{i18n>vehicleId}"/></Column>
                            <Column id="vehicleColVehicleInfo"><Text id="vehicleColVehicleInfoText" text="{i18n>vehicleInfo}"/></Column>
                            <Column id="vehicleColCategory"><Text id="vehicleColCategoryText" text="{i18n>category}"/></Column>
                            <Column id="vehicleColSpecs"><Text id="vehicleColSpecsText" text="{i18n>specs}"/></Column>
                            <Column id="vehicleColDailyRate" hAlign="Right"><Text id="vehicleColDailyRateText" text="{i18n>dailyRate}"/></Column>
                            <Column id="vehicleColMileage" hAlign="Right"><Text id="vehicleColMileageText" text="{i18n>mileage}"/></Column>
                            <Column id="vehicleColAvailability" hAlign="Center"><Text id="vehicleColAvailabilityText" text="{i18n>availability}"/></Column>
                            <Column id="vehicleColActions" width="12rem" hAlign="Center"><Text id="vehicleColActionsText" text="{i18n>actions}"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem id="vehicleListItem" vAlign="Middle">
                                <cells>
                                    <ObjectIdentifier id="vehicleCellVehicleId" title="{VehicleId}"/>
                                    <ObjectIdentifier id="vehicleCellVehicleInfo" title="{Brand}" text="{Model}"/>
                                    <ObjectStatus id="vehicleCellCategory" text="{Category}" inverted="true"
                                        state="{
                                            path: 'Category',
                                            formatter: '.formatter.categoryState'
                                        }"/>
                                    <Label id="vehicleCellSpecs" text="{
                                        parts: ['FuelType', 'Transmission'],
                                        formatter: '.formatter.specsText'
                                    }"/>
                                    <ObjectNumber id="vehicleCellDailyRate" number="{DailyRate}" unit="{CurrencyCode}" emphasized="true"/>
                                    <ObjectNumber id="vehicleCellMileage" number="{Mileage}" unit="km"/>
                                    <ObjectStatus id="vehicleCellAvailability"
                                        text="{
                                            path: 'Availability',
                                            formatter: '.formatter.availabilityText'
                                        }"
                                        state="{
                                            path: 'Availability',
                                            formatter: '.formatter.availabilityState'
                                        }"
                                        icon="{
                                            path: 'Availability',
                                            formatter: '.formatter.availabilityIcon'
                                        }"
                                        inverted="true"/>
                                    <HBox id="vehicleCellActions" justifyContent="Center">
                                        <Button id="vehicleBookButton"
                                            text="{i18n>bookNow}"
                                            icon="sap-icon://add-document"
                                            press=".onBookVehicle"
                                            type="Emphasized"
                                            visible="{= ${Availability} === true}"/>
                                        <Button id="vehicleEditButton" icon="sap-icon://edit"   tooltip="{i18n>edit}"   press=".onEditVehicle"   type="Transparent"/>
                                        <Button id="vehicleDeleteButton" icon="sap-icon://delete" tooltip="{i18n>delete}" press=".onDeleteVehicle" type="Transparent"/>
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
